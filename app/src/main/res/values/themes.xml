<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CosmoWatch" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="colorAccent">@color/accent</item>
        <item name="alertDialogTheme">@style/Theme.CosmoWatch.Dialog</item>
    </style>

    <style name="Theme.CosmoWatch.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorAlertDialogListItem">@color/text</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:background">@color/bg</item>
    </style>
</resources>
